# BayesMarket Environment Configuration
# Database: Neon Serverless PostgreSQL (https://neon.tech)
DATABASE_URL=postgres://user:password@ep-cool-pool-123456.us-east-2.aws.neon.tech/bayesmarket?sslmode=require

# Server Configuration
SERVER_PORT=8080
CORS_ORIGIN=http://localhost:4200
# Environment mode: local | dev | prod | production (dev bypasses & mock tokens only work in local/dev)
APP_ENV=local

# Security (Mandatory in production: minimum 32 chars for JWT_SECRET, 16 chars for ADMIN_TOKEN)
JWT_SECRET=GENERATE_RANDOM_HMAC_SHA256_KEY_MIN_32_CHARS
ADMIN_TOKEN=GENERATE_STRONG_RANDOM_ADMIN_TOKEN

# Google OAuth 2.0 (Optional for local dev simulation mode)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4200/auth/callback
